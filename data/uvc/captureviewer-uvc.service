[Unit]
Description=Load exact-kernel CaptureViewer UVC compatibility modules
Documentation=https://github.com/Wully616/CaptureViewer
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/captureviewer/uvc-helper/load.sh
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
